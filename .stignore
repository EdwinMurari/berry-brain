// Source only. Git metadata, secrets, runtime data, dependencies, and build output stay local.
(?d)**/._*
(?d)**/.DS_Store
(?d).git
(?d)**/.git
(?d).env
!**/.env.example
(?d).env.*
(?d)**/secrets
(?d)data
(?d)**/data
(?d)node_modules
(?d)**/node_modules
(?d)target
(?d)**/target
(?d)**/.venv
(?d)**/venv
(?d)**/__pycache__
(?d)**/.pytest_cache
(?d)**/.ruff_cache
(?d)**/.gradle
(?d)**/.kotlin
(?d)**/.idea
(?d)**/.next
(?d)**/dist
(?d)**/build
(?d)**/*.sqlite*
(?d)**/*.db
(?d)**/*.db-*
(?d)**/*.egg-info
(?d)**/*.whl
(?d)**/*.tar.gz
(?d)**/*.log
(?d)**/*.key
(?d)**/*.pem
(?d)**/*.token
(?d)**/*.sync-conflict-*
